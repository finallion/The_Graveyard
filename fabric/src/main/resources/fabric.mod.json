{
  "schemaVersion": 1,
  "id": "graveyard",
  "version": "${version}",

  "name": "The Graveyard",
  "description": "Adds new bosses, structures, mobs and blocks themed around the graveyard.",
  "authors": [
    "LithiumPlus"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/the-graveyard-fabric",
    "sources": "https://github.com/finallion/The_Graveyard",
    "issues": "https://github.com/finallion/The_Graveyard/issues"
  },

  "license": "GPL-3.0-only",
  "icon": "graveyard_logo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lion.graveyard.fabric.GraveyardFabric"
    ],
    "client": [
      "com.lion.graveyard.fabric.GraveyardClientFabric"
    ]
  },
  "mixins": [
    "graveyard-fabric.mixins.json",
    "graveyard-common.mixins.json",
    "graveyard-moonrise.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.162.0",
    "villagertradingplus": ">=1.1.0 <2",
    "minecraft": "26.3",
    "geckolib": ">=5.5.7 <6",
    "java": ">=25"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://www.patreon.com/cw/LithiumPlus"
      }
    }
  }
}
